<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:title="@string/about">

	<Preference
		android:key="about_brand"
		android:layout="@layout/pref_about_header"
		android:persistent="false"
		android:selectable="false" />

	<Preference
		android:icon="@drawable/ic_info_outline"
		android:key="app_version"
		android:persistent="false"
		android:summary="@string/check_for_updates" />

	<Preference
		android:icon="@drawable/ic_manga_source"
		android:key="parsers_version"
		android:persistent="false"
		android:title="@string/sources_version" />

	<Preference
		android:icon="@drawable/ic_script"
		android:key="about_github"
		android:persistent="false"
		android:summary="@string/url_github"
		android:title="@string/source_code"
		app:allowDividerAbove="true" />

</PreferenceScreen>
