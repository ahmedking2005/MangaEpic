<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<!-- Manga Epic: content-type filter chips for the sources section below.
	     Single selection; "All" is the default. -->
	<HorizontalScrollView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:fillViewport="true"
		android:scrollbars="none">

		<com.google.android.material.chip.ChipGroup
			android:id="@+id/chip_group_content_type"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingStart="16dp"
			android:paddingTop="12dp"
			android:paddingEnd="16dp"
			android:paddingBottom="4dp"
			app:selectionRequired="true"
			app:singleSelection="true">

			<com.google.android.material.chip.Chip
				android:id="@+id/chip_filter_all"
				style="@style/Widget.Kotatsu.Chip.Filter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:checked="true"
				android:text="@string/explore_filter_all" />

			<com.google.android.material.chip.Chip
				android:id="@+id/chip_filter_manga"
				style="@style/Widget.Kotatsu.Chip.Filter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/explore_filter_manga" />

			<com.google.android.material.chip.Chip
				android:id="@+id/chip_filter_novel"
				style="@style/Widget.Kotatsu.Chip.Filter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/explore_filter_novel" />

			<com.google.android.material.chip.Chip
				android:id="@+id/chip_filter_anime"
				style="@style/Widget.Kotatsu.Chip.Filter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/explore_filter_anime" />

		</com.google.android.material.chip.ChipGroup>

	</HorizontalScrollView>

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recyclerView"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:padding="@dimen/list_spacing_normal"
		android:orientation="vertical"
		android:scrollbars="vertical"
		tools:listitem="@layout/item_explore_source_list" />

</LinearLayout>
