<?xml version="1.0" encoding="utf-8"?>
<!-- Manga Epic brand mark, in-app twin of the splash mark: same artwork, but the
     disc takes the active colour scheme's primary colour (?attr/colorPrimary), so
     the logo recolours with the scheme — purple for Epic, blue for Rikka, etc.
     (The starting-window splash keeps the fixed Epic purple: it renders under the
     launcher theme before the user's runtime scheme applies.) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
	android:width="240dp"
	android:height="240dp"
	android:viewportWidth="240"
	android:viewportHeight="240">
	<path
		android:pathData="M120,120 m-84,0 a84,84 0 1,0 168,0 a84,84 0 1,0 -168,0"
		android:fillColor="?attr/colorPrimary" />
	<path
		android:pathData="M120,88 C104,78 84,74 66,78 L66,156 C84,152 104,156 120,166 Z"
		android:fillColor="#FFFFFF" />
	<path
		android:pathData="M120,88 C136,78 156,74 174,78 L174,156 C156,152 136,156 120,166 Z"
		android:fillColor="#E9DEF7" />
	<path
		android:pathData="M160,58 L164,68 L174,72 L164,76 L160,86 L156,76 L146,72 L156,68 Z"
		android:fillColor="#FFD54F" />
</vector>
